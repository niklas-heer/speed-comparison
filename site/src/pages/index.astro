---
import Layout from "../layouts/Layout.astro";
import RunDuration from "../components/RunDuration.astro";
import ResultTable from "../components/ResultTable.astro";
import { current, latest, timing } from "../lib/results.mjs";
const first = current.results[0];
const environment = first?.raw?.Environment ?? {};
const virtualized = environment.cpu_flags?.split(" ").includes("hypervisor");
const dateLabel = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(latest.id.slice(0, 10) + "T12:00:00Z"));
const workload = first?.rounds;
const examples = ["rust-simd", "c", "go", "java", "python"]
  .map((t) => current.results.find((r) => r.target === t))
  .filter(Boolean);
---

<Layout title="One calculation. Many ways to get there.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> An open programming language experiment
      </p><h1>One calculation.<br />Many ways to<br /><em>get there.</em></h1><p
        class="hero-description"
      >
        How do different implementations compute π? Explore the timings, the
        tradeoffs, and every recorded detail behind the numbers.
      </p><div class="hero-actions">
        <a class="button" href="#results">Explore the results <span>↓</span></a
        ><a class="text-link" href="/methodology/"
          >Understand the experiment ↗</a>
      </div>
    </div><aside
      class="hero-figure"
      aria-label="Selected implementation timings"
    >
      <div class="figure-top">
        <span>FIELD NOTES / 001</span><span>π ≈ 3.1415926535</span>
      </div><div class="formula">
        π = 4<span class="sigma">∑</span><span class="fraction"
          ><span>(−1)<sup>k</sup></span><span>2k + 1</span></span>
      </div><p class="figure-caption">
        {workload?.toLocaleString("en-US")} terms. A spectrum of approaches.
      </p><div class="mini-chart">
        {
          examples.map((r) => (
            <a href={`/results/${latest.id}/${r.target}/`}>
              <>
                <span>{r.name}</span>
                <i
                  style={`width:${Math.max(5, (Math.log10(1 + r.median * 1000) / 5) * 100)}%`}
                />
                <b>{timing(r.median)}</b>
              </>
            </a>
          ))
        }
      </div><div class="figure-bottom">
        <span>SELECTED VARIANTS · LOG SCALE</span><span
          >Inspect the conditions ↗</span>
      </div>
    </aside>
  </section>
  <div class="run-strip">
    <div>
      <span class="eyebrow">Latest published snapshot</span><strong
        >{dateLabel}</strong>
    </div><div>
      <span class="eyebrow">Implementations</span><strong
        >{current.results.length}<small>
          across multiple variants</small
        ></strong>
    </div><div>
      <span class="eyebrow">Workload</span><strong
        >{
          workload === 1_000_000_000
            ? "1 billion"
            : (workload?.toLocaleString("en-US") ?? "Not recorded")
        }<small> terms per execution</small></strong>
    </div><div>
      <span class="eyebrow">Environment</span><strong
        >{environment.arch ?? "Not recorded"}<small
          >{
            virtualized ? "Virtualized runner" : "See recorded environment"
          }</small
        ></strong>
    </div><a href={`/runs/${latest.id}/`}>Run details ↗</a>
  </div>
  <RunDuration data={current} />
  <section class="reading-note">
    <span class="note-icon">i</span><p>
      <strong>A benchmark is a set of conditions.</strong> These are timings for specific
      implementations, not a universal language ranking. Optimized math and SIMD are
      labeled; {
        latest.id === "2026-09-05T193245"
          ? "the current snapshot was measured on a shared virtual machine."
          : "each snapshot has its own hardware and protocol."
      } Small differences may be noise.
    </p><a href="/methodology/">Read the limitations ↗</a>
  </section>
  <section id="results" class="section">
    <div class="section-title">
      <div>
        <p class="eyebrow">01 / The measurements</p><h2>Follow the numbers.</h2>
      </div><p>
        Choose an implementation to inspect its samples,<br class="desktop" /> build
        commands, packages and environment.
      </p>
    </div><ResultTable results={current.results} runId={latest.id} />
  </section>
  <section class="section share-chart">
    <div><p class="eyebrow">The chart, to keep</p><h2>A picture of<br />the whole run.</h2>
      <p>All {current.results.length} implementations, package versions and measured spread. Median times match the table above. The logarithmic axis makes the full range readable.</p>
      <p>Explicit SIMD and relaxed math are marked. This is a comparison of these implementations under recorded conditions.</p>
      <a class="button" href={current.chart} download>Download the results image ↓</a>
    </div>
    <a class="share-chart-preview" href={current.chart}><img src={current.chart} width="2250" height={Math.max(7, current.results.length * 0.30 + 3.3) * 150} alt="All implementation medians with fastest-to-slowest sample ranges, compiler versions and run duration" loading="lazy" /></a>
  </section>
  <section class="journal-preview">
    <div>
      <p class="eyebrow">02 / Behind the experiment</p><h2>
        Behind the numbers.<br />Inside the experiment.
      </h2><p>
        Follow the code, explore the measurement, and meet the machinery behind the results.
      </p><a class="text-link" href="/journal/">Read the journal ↗</a>
    </div><a class="journal-card" href="/journal/how-code-becomes-a-benchmark/"
      ><div class="journal-card-top">
        <span class="badge">Inside the system</span><span>12 SEP 2026</span>
      </div><h3>
        How code becomes<br />a benchmark.
      </h3><p>
        Follow a source change through toolchains, caches, clocks and archives in an interactive walkthrough.
      </p><span class="text-link">Explore the story ↗</span></a>
  </section>
</Layout>
