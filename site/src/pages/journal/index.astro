---
import Layout from "../../layouts/Layout.astro";
import JournalArt from "../../components/journal/JournalArt.astro";
import { posts } from "../../lib/journal";
import "../../styles/journal.css";
---

<Layout
  title="Project journal"
  description="Inside a programming language benchmark: the code, the clocks and the decisions behind the results."
>
  <header class="page-heading journal-heading">
    <p class="eyebrow">The project journal / Field notes</p>
    <h1>Behind the numbers.<br /><em>Inside the experiment.</em></h1>
    <p class="lead">
      A small calculation opens up some surprisingly big questions. Explore the
      code, the clocks, and the decisions behind a programming language
      benchmark.
    </p>
  </header>
  <div class="story-grid">
    {
      posts.map(({ frontmatter: p, slug }, i) => (
        <a
          class:list={["story-card", { "story-feature": i === 0 }]}
          href={`/journal/${slug}/`}
        >
          <div class="story-card-art">
            <JournalArt kind={p.art} />
          </div>
          <div class="story-card-copy">
            <p class="eyebrow">
              {i === 0 ? "Start here / " : ""}
              {p.category}
            </p>
            <h2>{p.title}</h2>
            <p>{p.summary}</p>
            <div class="story-card-meta">
              <>
                <span>{p.readingTime} min read</span>
                <span class="text-link">Explore the story ↗</span>
              </>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Layout>
