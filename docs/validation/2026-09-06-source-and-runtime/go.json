    "src/leibniz.go": {
      "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc main() {\n\tfile, _ := os.ReadFile(\"rounds.txt\")\n\trounds, _ := strconv.Atoi(strings.TrimSpace(string(file)))\n\n\tx := 1.0\n\tpi := 1.0\n\tstop := float64(rounds + 2)\n\n\tfor i := 2.0; i <= stop; i++ {\n\t\tx = -x\n\t\tpi += x / (2.0*i - 1.0)\n\t}\n\n\tpi *= 4.0\n\tfmt.Println(pi)\n}\n",
      "sha256": "cbd91139fe92220e3ee179f7e0ffc1e02ff9712729e34a930140372473c9098e"
    }
  },
